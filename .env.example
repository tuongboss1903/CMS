# ============================================================
# CMS Da Website - Local Environment Configuration
# Copy file nay thanh ".env" (cung thu muc) roi chinh sua neu can.
# Gia tri o day khop dung mac dinh da co san trong config/*.php.
# ============================================================

APP_NAME="CMS Demo"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://cms.test
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_KEY=
APP_THEME=default

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cms_db
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
CACHE_PREFIX=cms

SESSION_COOKIE=cms_session
SESSION_LIFETIME=120
SESSION_SECURE=false

JWT_SECRET=
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=1209600

PASSWORD_RESET_TTL=3600

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=900

SYSTEM_ADMIN_DOMAINS=
